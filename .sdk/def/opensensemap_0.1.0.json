{
  "openapi": "3.0.3",
  "info": {
    "title": "openSenseMap API",
    "description": "The openSenseMap API allows for managing users, senseBoxes (stations), and measurements, providing functionalities such as posting new data, retrieving sensor information, and managing senseBoxes. It also supports various operations with parameters for filtering and formatting responses, including JSON and CSV formats.",
    "version": "1.0.0",
    "contact": {
      "name": "openSenseMap API Documentation",
      "url": "https://docs.opensensemap.org/"
    }
  },
  "servers": [
    {
      "url": "https://api.opensensemap.org",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "boxes",
      "description": "Operations related to senseBoxes (stations)"
    },
    {
      "name": "measurements",
      "description": "Operations related to sensor measurements"
    },
    {
      "name": "users",
      "description": "Operations related to user management"
    },
    {
      "name": "sensors",
      "description": "Operations related to sensors"
    }
  ],
  "paths": {
    "/boxes": {
      "get": {
        "tags": [
          "boxes"
        ],
        "summary": "Get all senseBoxes",
        "description": "Retrieve a list of all registered senseBoxes with optional filtering parameters",
        "operationId": "getBoxes",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "description": "Response format (json or csv)",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "csv"
              ],
              "default": "json"
            }
          },
          {
            "name": "bbox",
            "in": "query",
            "description": "Bounding box to filter senseBoxes (format: lng1,lat1,lng2,lat2)",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "exposure",
            "in": "query",
            "description": "Filter by exposure type",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "indoor",
                "outdoor",
                "mobile"
              ]
            }
          },
          {
            "name": "grouptag",
            "in": "query",
            "description": "Filter by group tag",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SenseBox"
                  }
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "tags": [
          "boxes"
        ],
        "summary": "Register a new senseBox",
        "description": "Create and register a new senseBox station",
        "operationId": "createBox",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SenseBoxInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "SenseBox created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SenseBox"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/boxes/{boxId}": {
      "get": {
        "tags": [
          "boxes"
        ],
        "summary": "Get senseBox by ID",
        "description": "Retrieve detailed information about a specific senseBox",
        "operationId": "getBoxById",
        "parameters": [
          {
            "name": "boxId",
            "in": "path",
            "description": "ID of the senseBox",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "Response format (json or csv)",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "csv"
              ],
              "default": "json"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SenseBox"
                }
              }
            }
          },
          "404": {
            "description": "SenseBox not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "put": {
        "tags": [
          "boxes"
        ],
        "summary": "Update senseBox",
        "description": "Update information about a specific senseBox",
        "operationId": "updateBox",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "boxId",
            "in": "path",
            "description": "ID of the senseBox",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SenseBoxInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SenseBox updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SenseBox"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "SenseBox not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "delete": {
        "tags": [
          "boxes"
        ],
        "summary": "Delete senseBox",
        "description": "Delete a specific senseBox",
        "operationId": "deleteBox",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "boxId",
            "in": "path",
            "description": "ID of the senseBox",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SenseBox deleted successfully"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "SenseBox not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/boxes/{boxId}/sensors": {
      "get": {
        "tags": [
          "sensors"
        ],
        "summary": "Get sensors for a senseBox",
        "description": "Retrieve all sensors associated with a specific senseBox",
        "operationId": "getBoxSensors",
        "parameters": [
          {
            "name": "boxId",
            "in": "path",
            "description": "ID of the senseBox",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Sensor"
                  }
                }
              }
            }
          },
          "404": {
            "description": "SenseBox not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/boxes/{boxId}/data": {
      "post": {
        "tags": [
          "measurements"
        ],
        "summary": "Post new measurements",
        "description": "Submit new measurement data for a senseBox",
        "operationId": "postMeasurements",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "boxId",
            "in": "path",
            "description": "ID of the senseBox",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MeasurementInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Measurements posted successfully"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "SenseBox not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/boxes/{boxId}/{sensorId}": {
      "get": {
        "tags": [
          "measurements"
        ],
        "summary": "Get measurements for a sensor",
        "description": "Retrieve measurement data for a specific sensor",
        "operationId": "getSensorMeasurements",
        "parameters": [
          {
            "name": "boxId",
            "in": "path",
            "description": "ID of the senseBox",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sensorId",
            "in": "path",
            "description": "ID of the sensor",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from-date",
            "in": "query",
            "description": "Start date for filtering measurements (ISO 8601 format)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to-date",
            "in": "query",
            "description": "End date for filtering measurements (ISO 8601 format)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "Response format (json or csv)",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "csv"
              ],
              "default": "json"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Measurement"
                  }
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "SenseBox or sensor not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/users/register": {
      "post": {
        "tags": [
          "users"
        ],
        "summary": "Register a new user",
        "description": "Create a new user account",
        "operationId": "registerUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserRegistration"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "409": {
            "description": "User already exists"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/users/sign-in": {
      "post": {
        "tags": [
          "users"
        ],
        "summary": "Sign in user",
        "description": "Authenticate a user and receive an access token",
        "operationId": "signInUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserSignIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sign in successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "JWT access token"
                    },
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/users/me": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "Get current user profile",
        "description": "Retrieve profile information for the authenticated user",
        "operationId": "getCurrentUser",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/statistics/descriptive": {
      "get": {
        "tags": [
          "measurements"
        ],
        "summary": "Get descriptive statistics",
        "description": "Retrieve descriptive statistics for measurements",
        "operationId": "getDescriptiveStatistics",
        "parameters": [
          {
            "name": "boxId",
            "in": "query",
            "description": "ID of the senseBox",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sensorId",
            "in": "query",
            "description": "ID of the sensor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from-date",
            "in": "query",
            "description": "Start date for statistics (ISO 8601 format)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to-date",
            "in": "query",
            "description": "End date for statistics (ISO 8601 format)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Statistics"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SenseBox": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "description": "Unique identifier for the senseBox"
          },
          "name": {
            "type": "string",
            "description": "Name of the senseBox"
          },
          "description": {
            "type": "string",
            "description": "Description of the senseBox"
          },
          "exposure": {
            "type": "string",
            "enum": [
              "indoor",
              "outdoor",
              "mobile"
            ],
            "description": "Exposure type of the senseBox"
          },
          "model": {
            "type": "string",
            "description": "Model of the senseBox"
          },
          "grouptag": {
            "type": "string",
            "description": "Group tag for categorization"
          },
          "location": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "Point"
                ]
              },
              "coordinates": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2,
                "description": "Longitude and latitude coordinates [lng, lat]"
              }
            }
          },
          "sensors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Sensor"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Last update timestamp"
          }
        }
      },
      "SenseBoxInput": {
        "type": "object",
        "required": [
          "name",
          "exposure",
          "location"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the senseBox"
          },
          "description": {
            "type": "string",
            "description": "Description of the senseBox"
          },
          "exposure": {
            "type": "string",
            "enum": [
              "indoor",
              "outdoor",
              "mobile"
            ],
            "description": "Exposure type of the senseBox"
          },
          "model": {
            "type": "string",
            "description": "Model of the senseBox"
          },
          "grouptag": {
            "type": "string",
            "description": "Group tag for categorization"
          },
          "location": {
            "type": "object",
            "required": [
              "type",
              "coordinates"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "Point"
                ]
              },
              "coordinates": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2,
                "description": "Longitude and latitude coordinates [lng, lat]"
              }
            }
          },
          "sensors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SensorInput"
            }
          }
        }
      },
      "Sensor": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "description": "Unique identifier for the sensor"
          },
          "title": {
            "type": "string",
            "description": "Title of the sensor"
          },
          "unit": {
            "type": "string",
            "description": "Unit of measurement"
          },
          "sensorType": {
            "type": "string",
            "description": "Type of sensor"
          },
          "icon": {
            "type": "string",
            "description": "Icon identifier for the sensor"
          },
          "lastMeasurement": {
            "$ref": "#/components/schemas/Measurement"
          }
        }
      },
      "SensorInput": {
        "type": "object",
        "required": [
          "title",
          "unit",
          "sensorType"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "Title of the sensor"
          },
          "unit": {
            "type": "string",
            "description": "Unit of measurement"
          },
          "sensorType": {
            "type": "string",
            "description": "Type of sensor"
          },
          "icon": {
            "type": "string",
            "description": "Icon identifier for the sensor"
          }
        }
      },
      "Measurement": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "description": "Measurement value"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp of the measurement"
          }
        }
      },
      "MeasurementInput": {
        "type": "object",
        "additionalProperties": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string"
                  },
                  "createdAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          ]
        },
        "example": {
          "sensor1": "23.5",
          "sensor2": [
            {
              "value": "23.5",
              "createdAt": "2023-01-01T12:00:00Z"
            }
          ]
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "description": "Unique identifier for the user"
          },
          "name": {
            "type": "string",
            "description": "User's name"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "User's email address"
          },
          "role": {
            "type": "string",
            "description": "User's role"
          },
          "boxes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Array of senseBox IDs owned by the user"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Account creation timestamp"
          }
        }
      },
      "UserRegistration": {
        "type": "object",
        "required": [
          "name",
          "email",
          "password"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "User's name"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "User's email address"
          },
          "password": {
            "type": "string",
            "format": "password",
            "description": "User's password"
          }
        }
      },
      "UserSignIn": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "User's email address"
          },
          "password": {
            "type": "string",
            "format": "password",
            "description": "User's password"
          }
        }
      },
      "Statistics": {
        "type": "object",
        "properties": {
          "mean": {
            "type": "number",
            "description": "Mean value"
          },
          "median": {
            "type": "number",
            "description": "Median value"
          },
          "min": {
            "type": "number",
            "description": "Minimum value"
          },
          "max": {
            "type": "number",
            "description": "Maximum value"
          },
          "count": {
            "type": "integer",
            "description": "Number of measurements"
          },
          "sum": {
            "type": "number",
            "description": "Sum of all values"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT authentication token"
      }
    }
  }
}
