# BasicBoxFlow

main: kit: flow: BasicBoxFlow:
{
  entity: "box",
  kind: "basic",
  name: "BasicBoxFlow",
  step: [
    {
      input: {
        ref: "box_ref01"
      }

      match: {
        box_id: "box01",
        sensor_id: "sensor01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "box_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "box_ref01",
        srcdatavar: "box_ref01_data",
        suffix: "_up0",
        textfield: "createdAt"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-box_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "box_ref01",
        srcdatavar: "box_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "box01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-box_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "box_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "box01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "box_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicBoxFlow"
}